	analyst --> risk;
	compliance --> human_approval;
	critic -.-> compliance;
	critic -.-> writer;
	human_approval -.-> end_skipped;
	human_approval -.-> submit_live;
	matcher -.-> needs_attention;
	matcher -.-> pricing;
	pricing -.-> end_skipped;
