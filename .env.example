# ==============================================================================
# GigBid Environment Variables Template
# Copy this file to .env and populate real credentials for local deployment.
# ==============================================================================

# General
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# Auth & Encryption Secrets (Fernet key generated via cryptography.fernet.Fernet.generate_key())
JWT_SECRET_KEY=change-this-in-production-to-a-secure-random-32-byte-hex
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
OAUTH_FERNET_KEY=0123456789abcdef0123456789abcdef0123456789a=

# Preloaded Reviewer Credentials
REVIEWER_EMAIL=reviewer@gigbid.ai
REVIEWER_PASSWORD=reviewer-demo-pass

# LLM Providers (Open Profile defaults to local Ollama or mock/deterministic engine)
OLLAMA_BASE_URL=http://localhost:11434
GROQ_API_KEY=
OPENAI_API_KEY=

# RAG & Embeddings
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
EMBEDDING_FALLBACK_DETERMINISTIC=true

# Databases & Checkpointing
DATABASE_URL=sqlite:///./gigbid.db
CHECKPOINT_DB_PATH=./gigbid_checkpoints.db

# GigSim & Marketplace
GIGSIM_BASE_URL=http://localhost:8001
MARKETPLACE_ADAPTER=gigsim
UPWORK_MCP_URL=https://mcp.upwork.com/mcp
UPWORK_OAUTH_CLIENT_ID=
UPWORK_OAUTH_CLIENT_SECRET=
GITHUB_TOKEN=

# Internal MCP Server Ports (if hosted over HTTP/SSE)
PORTFOLIO_MCP_PORT=8010
MARKETPLACE_MCP_PORT=8011
WORKSPACE_MCP_PORT=8012

# Application Ports
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=3000
